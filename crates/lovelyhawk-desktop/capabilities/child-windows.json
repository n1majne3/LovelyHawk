{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "child-windows",
  "description": "Terminal, container-terminal and file-editor windows: only the commands that act on the binding the host recorded for them.",
  "local": true,
  "windows": [
    "child-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "allow-terminal-open",
    "allow-terminal-open-tab",
    "allow-terminal-poll",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-search",
    "allow-terminal-copy-selection",
    "allow-terminal-ai-assist",
    "allow-terminal-close-tab",
    "allow-terminal-close",
    "allow-sftp-open",
    "allow-sftp-list",
    "allow-sftp-read-text",
    "allow-sftp-download",
    "allow-sftp-download-directory",
    "allow-sftp-upload-directory-prepare",
    "allow-sftp-upload-directory-run",
    "allow-sftp-upload-directory-discard",
    "allow-sftp-queue-download",
    "allow-sftp-queue-upload",
    "allow-sftp-queue-poll",
    "allow-sftp-queue-cancel-all",
    "allow-sftp-queue-retry",
    "allow-sftp-relay-targets",
    "allow-sftp-relay-start",
    "allow-sftp-relay-poll",
    "allow-sftp-relay-cancel",
    "allow-sftp-plan",
    "allow-sftp-confirm",
    "allow-sftp-execute",
    "allow-sftp-cancel",
    "allow-sftp-undo",
    "allow-sqlite-sftp-inspect",
    "allow-sqlite-sftp-rows",
    "allow-sqlite-sftp-delete-plan",
    "allow-sqlite-sftp-delete-execute",
    "allow-sqlite-sftp-delete-undo",
    "allow-sftp-cancel-transfer",
    "allow-sftp-stage-upload",
    "allow-local-open",
    "allow-local-list",
    "allow-local-scan-child",
    "allow-local-scan-child-configure",
    "allow-file-editor-open",
    "allow-directory-terminal-open",
    "allow-file-editor-target",
    "allow-file-editor-unsaved",
    "allow-child-close-decision"
  ]
}